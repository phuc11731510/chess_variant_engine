#!/bin/bash
# ssh GIA cho bo thu vong lap lien tuc: chay lenh ngay trong khong gian ten (namespace) cua cua so = "may Colab" cua no (/content rieng).
# Giong ssh that: ssh [-o X]... host lenh...   (stdin duoc chuyen tiep). May chua duoc xin (khong co /content/.maychu) hoac bi danh dau
# mat (/content/.mat) thi ma thoat 255 nhu ssh khong noi duoc.
while [ $# -gt 0 ]; do
  case "$1" in
    -o) shift 2 ;;
    -*) shift ;;
    *) break ;;
  esac
done
shift   # host
[ -e /content/.maychu ] && [ ! -e /content/.mat ] || { echo "ssh: khong noi duoc (may khong con)" >&2; exit 255; }
# Mo phong 429 "Already-active SSH session" (Colab chua giai phong phien ssh cu sau mot lan dut): tep $FAKE_DIR/loi429 (so lan, cho lenh hoi danh sach
# goi tren may) va $FAKE_DIR/loi429_tar (so lan, cho luong tar dua goi len: doc mot phan du lieu roi bi tu choi giua chung).
tru() { local f=${FAKE_DIR:-/tmp/fc}/$1 n; [ -f "$f" ] || return 1; n=$(cat "$f"); [ "${n:-0}" -gt 0 ] || return 1; echo $((n - 1)) > "$f"; }
case "$*" in
  *"tar xf"*)       tru loi429_tar && { head -c 30000 > /dev/null; echo "[colab] Already-active SSH session (HTTP 429): another \`colab ssh\` is connected to this runtime. Disconnect it and retry." >&2; exit 255; } ;;
  *"FZ_LIET_XONG"*) tru loi429     && { echo "[colab] Already-active SSH session (HTTP 429): another \`colab ssh\` is connected to this runtime. Disconnect it and retry." >&2; exit 255; } ;;
esac
exec bash -c "$*"
