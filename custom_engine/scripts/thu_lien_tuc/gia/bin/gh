#!/bin/bash
# gh GIA: "Release NN_Model" la thu muc $FAKE_RELEASE. Chi cac lenh ma td_len_github / td_kiem_len / td_don_dep dung.
R=${FAKE_RELEASE:-/tmp/fc/release}
mkdir -p "$R"
case "$1" in
  auth) exit 0 ;;
  api)
    shift
    case "$*" in
      *"releases/tags/"*) echo 4242 ;;
      *"/assets"*)
        for f in "$R"/*; do
          [ -f "$f" ] || continue
          printf '%s\t%s\tsha256:%s\n' "$(basename "$f")" "$(stat -c %s "$f")" "$(sha256sum "$f" | cut -d' ' -f1)"
        done ;;
      *) exit 1 ;;
    esac ;;
  release)
    # gh release upload TAG FILE --clobber -R REPO
    [ "$2" = upload ] || exit 1
    if [ -n "${GH_TOKEN:-}" ]; then      # goi tu may Colab (token qua GH_TOKEN): ghi lai; gia loi neu co tep gh_colab_loi
      echo "TOKEN:$GH_TOKEN" >> "${FAKE_DIR:-/tmp/fc}/gh_token.log"
      f=${FAKE_DIR:-/tmp/fc}/gh_colab_loi; n=$(cat "$f" 2>/dev/null); if [ "${n:-0}" -gt 0 ]; then echo $((n - 1)) > "$f"; echo "HTTP 403: Resource not accessible by personal access token" >&2; exit 1; fi
    fi
    cp -f "$4" "$R/$(basename "$4")" ;;
  *) exit 1 ;;
esac
